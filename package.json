{
  "name": "jforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:landing": "pnpm --filter @jforge/landing dev",
    "dev:melee": "pnpm --filter @jforge/melee dev",
    "dev:jrpg": "pnpm --filter @jforge/jrpg dev",
    "dev:char": "pnpm --filter @jforge/char dev",
    "build": "tsc -b && node tooling/clean-dist.mjs && pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "pnpm build && wrangler deploy",
    "portraits": "node modules/melee/scripts/portraits.mjs && prettier --write modules/melee/src/battle/portraitIcons.ts"
  },
  "dependencies": {
    "@jforge/char": "workspace:*",
    "@jforge/jrpg": "workspace:*",
    "@jforge/melee": "workspace:*",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  }
}
