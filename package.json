{
  "name": "jforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:landing": "pnpm --filter @jforge/landing dev",
    "dev:melee": "pnpm --filter @jforge/melee dev",
    "dev:jrpg": "pnpm --filter @jforge/jrpg dev",
    "dev:char": "pnpm --filter @jforge/char dev",
    "dev:autob": "pnpm --filter @jforge/autob dev",
    "build": "tsc -b && node tooling/clean-dist.mjs && pnpm -r --workspace-concurrency=1 build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "pnpm build && wrangler deploy",
    "portraits": "node libs/look/scripts/portraits.mjs && prettier --write libs/look/portraitIcons.ts"
  },
  "dependencies": {
    "@jforge/autob": "workspace:*",
    "@jforge/char": "workspace:*",
    "@jforge/jrpg": "workspace:*",
    "@jforge/melee": "workspace:*",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.162.0"
  }
}
